# ---------------------------------------------------------------------------
# ScholarAI environment
# Copy to .env (local) or paste into Vercel → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Postgres connection string.
#
# Local development:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Supabase — transaction pooler (recommended for Vercel/serverless):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Supabase — session pooler / direct (long-lived servers, migrations):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Optional: enables Gemini-powered analysis instead of the deterministic local engine.
# Server-side only — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
